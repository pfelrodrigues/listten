#!/usr/bin/env bash
# Build and test with warnings as errors before pushing. Nothing with a
# warning reaches the remote.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v swift >/dev/null 2>&1; then
  echo "pre-push: swift not found on PATH (need Xcode)." >&2
  exit 1
fi

echo "pre-push: architecture rules"
bash scripts/lint.sh

echo "pre-push: swift build (warnings are errors)"
swift build -Xswiftc -warnings-as-errors

echo "pre-push: swift test (warnings are errors)"
swift test -Xswiftc -warnings-as-errors

echo "pre-push: ok"
